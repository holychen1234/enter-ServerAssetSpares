# ================================================================
# 主机资产管理平台 — 环境变量
# ================================================================
# 部署脚本 deploy.sh 首次运行时会自动生成 JWT_SECRET。
# 生产环境请务必修改下面标注了「必须修改」的字段。
# 此文件权限应为 600（deploy.sh 会自动设置）。
# ================================================================

# ===== MySQL =====
# ！！！必须修改：生产环境请使用强密码
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=cmdb
MYSQL_PASSWORD=cmdb123
MYSQL_DATABASE=cmdb

# ===== JWT =====
# deploy.sh 首次运行时会自动替换为随机生成的 64 位 hex 串。
# 手动部署时请自己生成: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALG=HS256
JWT_TTL_HOURS=12

# ===== Web exposure =====
# 对外暴露的端口，修改后记得防火墙放行。
WEB_PORT=8080

# ===== CORS =====
# 同源部署（nginx 反向代理）用 "*" 即可。
# 若前后端分离部署，改为前端域名，如 "https://cmdb.example.com"
CORS_ORIGINS=*

# ===== BMC (Redfish/IPMI) =====
# 默认 Redfish 地址。Redfish Mock 仅开发/演示用，默认不启动。
# 生产环境改为真实 BMC 地址，如 "https://10.10.20.11"
REDFISH_DEFAULT_BASE=http://redfish-mock:8000
REDFISH_TIMEOUT_SECONDS=30

# ===== AI query API key (Feishu Aily integration) =====
# 用于飞书 Aily 智能问答调用 CMDB 查询接口的认证密钥
# 生成方式: openssl rand -hex 32
AI_API_KEY=

# ===== Background polling =====
# BMC 在线轮询间隔（秒），0 禁用。
# 注意：此间隔应大于「服务器数 / 并发数 × 单台采集耗时」，
# 否则巡检会堆积（日志出现 "maximum number of running instances reached"）。
# 20 台服务器建议 ≥ 300 秒；100 台建议 ≥ 600 秒。
# Prometheus 导出器会独立以 REDFISH_EXPORTER_INTERVAL 秒为周期采集，
# 两者都会访问 BMC，间隔不要太短以免 BMC 过载返回 503。
POLL_INTERVAL_SECONDS=60
