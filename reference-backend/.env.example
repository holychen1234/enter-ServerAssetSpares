# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=cmdb
MYSQL_PASSWORD=cmdb123
MYSQL_DATABASE=cmdb

# JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALG=HS256
JWT_TTL_HOURS=12

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# BMC defaults (used when a server has no explicit redfish_base override)
REDFISH_DEFAULT_BASE=http://redfish-mock:8000
