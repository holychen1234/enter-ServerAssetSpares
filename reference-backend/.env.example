# ===== MySQL =====
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=cmdb
MYSQL_PASSWORD=cmdb123
MYSQL_DATABASE=cmdb

# ===== JWT =====
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALG=HS256
JWT_TTL_HOURS=12

# ===== Web exposure =====
# The only port published to the host. Open this in the firewall.
WEB_PORT=8080

# ===== CORS =====
# Same-origin deployment via nginx → "*" is fine. Lock down in dev as needed.
CORS_ORIGINS=*

# ===== BMC =====
# Default Redfish base used when a server's mgmt_ip is unreachable. The shipped
# value points at the docker-compose Redfish mock container.
REDFISH_DEFAULT_BASE=http://redfish-mock:8000
REDFISH_TIMEOUT_SECONDS=4

# ===== Background polling =====
# 0 to disable, otherwise seconds between BMC polls for online servers
POLL_INTERVAL_SECONDS=60
