        "summary": "搜索终端资产",
        "description": "按关键词或多条件搜索终端资产（办公电脑、笔记本等），返回计算机名、SN、资产编号、厂商、型号、OS、使用人、部门、IP、状态。适用场景：用户问「市场部有多少台电脑」「Windows 11 的终端有哪些」「张三的电脑配置」「公司有几台 Mac」等。",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {"type": "string"},
            "description": "任意关键词，模糊匹配计算机名/SN/资产编号/IP/型号/使用人/部门"
          },
          {
            "name": "manufacturer",
            "in": "query",
            "required": false,
            "schema": {"type": "string"},
            "description": "厂商过滤: Dell, HP, Lenovo, Apple, Huawei, ASUS, Acer, Microsoft, Other"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "enum": ["online", "offline", "maintenance", "retired"]},
            "description": "状态过滤"
          },
          {
            "name": "os",
            "in": "query",
            "required": false,
            "schema": {"type": "string"},
            "description": "操作系统过滤，如 Windows 11 / macOS / Ubuntu"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "default": 20, "minimum": 1, "maximum": 100},
            "description": "返回条数上限"
          }
        ],
        "responses": {
          "200": {
            "description": "匹配的终端资产列表",
            "content": {
