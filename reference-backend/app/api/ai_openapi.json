                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {"type": "integer"},
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "hostname": {"type": "string"},
                          "sn": {"type": "string"},
                          "assetTag": {"type": "string"},
                          "manufacturer": {"type": "string"},
                          "model": {"type": "string"},
                          "os": {"type": "string"},
                          "bizIp": {"type": "string"},
                          "userName": {"type": "string"},
                          "status": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
