{
  "openapi": "3.0.3",
  "info": {
    "title": "CMDB AI 查询工具包",
    "description": "主机资产管理与备件库存查询接口，供 Dify / Aily 等 AI Agent 平台调用。所有接口通过 X-API-Key 鉴权。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://your-domain.com/api",
      "description": "CMDB 私有部署地址，替换 your-domain.com 为实际域名或 IP"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "在 CMDB 后端 .env 中 AI_API_KEY 配置的密钥"
      }
    }
  },
  "paths": {
    "/ai/search-servers": {
      "get": {
        "operationId": "search_servers",
        "summary": "搜索主机资产",
        "description": "按关键词或多条件搜索主机资产列表，返回主机名、SN、型号、CPU、内存、磁盘、IP、位置等信息。适用场景：用户问「数据库服务器有几台」「查一下 DB-SH 开头的机器」「IDC-A 有哪些在线服务器」等。",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "任意关键词，模糊匹配主机名/SN/资产编号/IP/型号/厂商/CPU型号/IDC/备注"
          },
          {
            "name": "hostname",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "主机名精确匹配"
          },
          {
            "name": "sn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "SN序列号精确匹配"
          },
          {
            "name": "ip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "IP地址匹配（业务IP或管理IP）"
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "服务器型号"
          },
          {
            "name": "manufacturer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "厂商过滤，支持中英文（戴尔/Dell, 惠普/HPE, 联想/Lenovo, 浪潮/Inspur, 超微/Supermicro, 华为/Huawei, 超聚变/XFusion, 其他/Other）"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "online",
                "offline",
                "maintenance",
                "retired"
              ]
            },
            "description": "状态过滤"
          },
          {
            "name": "idc",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "IDC机房过滤"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "description": "返回条数上限"
          }
        ],
        "responses": {
          "200": {
            "description": "匹配的主机列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "hostname": {
                            "type": "string"
                          },
                          "sn": {
                            "type": "string"
                          },
                          "assetTag": {
                            "type": "string"
                          },
                          "manufacturer": {
                            "type": "string"
                          },
                          "model": {
                            "type": "string"
                          },
                          "cpuModel": {
                            "type": "string"
                          },
                          "cpuCount": {
                            "type": "integer"
                          },
                          "memoryGB": {
                            "type": "integer"
                          },
                          "diskCount": {
                            "type": "integer"
                          },
                          "status": {
                            "type": "string"
                          },
                          "mgmtIp": {
                            "type": "string"
                          },
                          "bizIp": {
                            "type": "string"
                          },
                          "location": {
                            "type": "object",
                            "properties": {
                              "idc": {
                                "type": "string"
                              },
                              "rack": {
                                "type": "string"
                              },
                              "uPosition": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/get-server-detail": {
      "get": {
        "operationId": "get_server_detail",
        "summary": "获取主机完整详情",
        "description": "根据主机名、SN序列号、资产编号或IP地址获取单台主机的全部资产信息。适用场景：用户问「DB-SH-01 的 CPU 型号是什么」「SN:ABC123 的内存多大」「10.0.1.5 是哪台机器」「资产编号 AST-001 的机器配置」等。",
        "parameters": [
          {
            "name": "identifier",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "主机名、SN序列号、资产编号或IP地址（管理IP或业务IP）"
          }
        ],
        "responses": {
          "200": {
            "description": "主机详情",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "found": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "hostname": {
                      "type": "string"
                    },
                    "sn": {
                      "type": "string"
                    },
                    "cpuModel": {
                      "type": "string"
                    },
                    "cpuCount": {
                      "type": "integer"
                    },
                    "memoryGB": {
                      "type": "integer"
                    },
                    "diskCount": {
                      "type": "integer"
                    },
                    "status": {
                      "type": "string"
                    },
                    "mgmtIp": {
                      "type": "string"
                    },
                    "bizIp": {
                      "type": "string"
                    },
                    "location": {
                      "type": "object",
                      "properties": {
                        "idc": {
                          "type": "string"
                        },
                        "rack": {
                          "type": "string"
                        },
                        "uPosition": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/search-parts": {
      "get": {
        "operationId": "search_parts",
        "summary": "搜索备件库存",
        "description": "按关键词或多条件搜索备件库存，返回类别、品牌、型号、规格、库存数量、安全库存、存放位置。适用场景：用户问「2TB SSD 还有多少」「Intel 内存的库存」「有哪些网卡」等。",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "任意关键词，模糊匹配品牌/型号/规格/SN/备注"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "disk",
                "memory",
                "nic",
                "optical",
                "other"
              ]
            },
            "description": "类别"
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "品牌"
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "型号"
          },
          {
            "name": "spec",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "规格，如 2TB SSD / DDR4 3200"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "in_stock",
                "allocated",
                "in_use",
                "scrapped"
              ]
            },
            "description": "状态过滤"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "description": "返回条数上限"
          }
        ],
        "responses": {
          "200": {
            "description": "匹配的备件列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "category": {
                            "type": "string",
                            "enum": [
                              "disk",
                              "memory",
                              "nic",
                              "optical",
                              "other"
                            ]
                          },
                          "brand": {
                            "type": "string"
                          },
                          "model": {
                            "type": "string"
                          },
                          "spec": {
                            "type": "string"
                          },
                          "sn": {
                            "type": "string"
                          },
                          "stock": {
                            "type": "integer"
                          },
                          "safetyStock": {
                            "type": "integer"
                          },
                          "unit": {
                            "type": "string"
                          },
                          "location": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/get-server-stats": {
      "get": {
        "operationId": "get_server_stats",
        "summary": "统计主机资产概况",
        "description": "按指定维度统计主机数量分布。适用场景：用户问「各机房有多少台机器」「在线和离线分别多少台」「各厂商服务器分布」等。",
        "parameters": [
          {
            "name": "group_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "status",
                "idc",
                "manufacturer"
              ],
              "default": "status"
            },
            "description": "统计维度"
          }
        ],
        "responses": {
          "200": {
            "description": "统计数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "groupBy": {
                      "type": "string"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "count": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/get-server-disks": {
      "get": {
        "operationId": "get_server_disks",
        "summary": "获取主机硬盘列表",
        "description": "获取某台主机的所有硬盘详细信息，包括型号、序列号、容量、介质类型、健康状态。数据来源于 BMC Redfish 实时采集。适用场景：用户问「DB-SH-01 有几块硬盘」「192.168.1.5 的硬盘型号是什么」「查一下这台机器的磁盘配置」等。",
        "parameters": [
          {
            "name": "identifier",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "主机名、SN序列号、资产编号或IP地址"
          }
        ],
        "responses": {
          "200": {
            "description": "硬盘列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "found": {
                      "type": "boolean"
                    },
                    "hostname": {
                      "type": "string"
                    },
                    "sn": {
                      "type": "string"
                    },
                    "diskCountDb": {
                      "type": "integer"
                    },
                    "source": {
                      "type": "string"
                    },
                    "diskCountBmc": {
                      "type": "integer"
                    },
                    "drives": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "model": {
                            "type": "string"
                          },
                          "sn": {
                            "type": "string"
                          },
                          "capacityGB": {
                            "type": "integer"
                          },
                          "mediaType": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/search-network-devices": {
      "get": {
        "operationId": "search_network_devices",
        "summary": "搜索网络设备",
        "description": "按关键词或多条件搜索网络设备列表，返回设备名、SN、类型、厂商、型号、管理IP、状态、机房。适用场景：用户问「核心交换机有几台」「查一下 Cisco 路由器」「防火墙的状态是什么」等。",
        "parameters": [
          {"name": "keyword", "in": "query", "required": false, "schema": {"type": "string"}, "description": "任意关键词，模糊匹配设备名/SN/资产编号/管理IP/型号/厂商/IDC"},
          {"name": "device_type", "in": "query", "required": false, "schema": {"type": "string", "enum": ["switch", "router", "firewall", "load_balancer"]}, "description": "设备类型"},
          {"name": "manufacturer", "in": "query", "required": false, "schema": {"type": "string"}, "description": "厂商过滤，支持中英文（思科/Cisco, 华为/Huawei, 华三/H3C, Arista, 瞻博/Juniper, 锐捷/Ruijie, 其他/Other）"},
          {"name": "status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["online", "offline", "maintenance", "retired"]}, "description": "状态过滤"},
          {"name": "idc", "in": "query", "required": false, "schema": {"type": "string"}, "description": "机房过滤"},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 20, "minimum": 1, "maximum": 100}, "description": "返回条数上限"}
        ],
        "responses": {
          "200": {
            "description": "匹配的网络设备列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {"type": "integer"},
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "hostname": {"type": "string"},
                          "sn": {"type": "string"},
                          "assetTag": {"type": "string"},
                          "deviceType": {"type": "string", "enum": ["switch", "router", "firewall", "load_balancer"]},
                          "manufacturer": {"type": "string"},
                          "model": {"type": "string"},
                          "mgmtIp": {"type": "string"},
                          "bizIp": {"type": "string"},
                          "status": {"type": "string"},
                          "idc": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/get-network-device-detail": {
      "get": {
        "operationId": "get_network_device_detail",
        "summary": "获取网络设备完整详情",
        "description": "根据设备名、SN序列号、资产编号或管理IP获取单台网络设备的全部配置信息，包括固件版本、端口数量、VLAN、管理协议等。适用场景：用户问「bj-core-sw-01 的固件版本是什么」「这台交换机有多少端口」「查一下设备 SN:NDEV001 的配置」等。",
        "parameters": [
          {"name": "identifier", "in": "query", "required": true, "schema": {"type": "string"}, "description": "设备名、SN序列号、资产编号或管理IP地址"}
        ],
        "responses": {
          "200": {
            "description": "网络设备详情",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "found": {"type": "boolean"},
                    "message": {"type": "string"},
                    "hostname": {"type": "string"},
                    "sn": {"type": "string"},
                    "assetTag": {"type": "string"},
                    "deviceType": {"type": "string"},
                    "manufacturer": {"type": "string"},
                    "model": {"type": "string"},
                    "firmwareVersion": {"type": "string"},
                    "mgmtIp": {"type": "string"},
                    "mgmtProtocol": {"type": "string"},
                    "mgmtPort": {"type": "integer"},
                    "bizIp": {"type": "string"},
                    "vlan": {"type": "string"},
                    "portCount": {"type": "integer"},
                    "idc": {"type": "string"},
                    "rack": {"type": "string"},
                    "status": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/search-workstations": {
      "get": {
        "operationId": "search_workstations",
        "summary": "搜索终端PC",
        "description": "按关键词或多条件搜索终端PC列表，返回计算机名、SN、厂商、型号、操作系统、IP、使用人、部门、状态。适用场景：用户问「财务部有多少台电脑」「Windows 11 的机器有哪些」「查一下张三用的电脑」等。",
        "parameters": [
          {"name": "keyword", "in": "query", "required": false, "schema": {"type": "string"}, "description": "任意关键词，模糊匹配计算机名/SN/资产编号/IP/型号/使用人/部门"},
          {"name": "manufacturer", "in": "query", "required": false, "schema": {"type": "string"}, "description": "厂商过滤，支持中英文（戴尔/Dell, 惠普/HP, 联想/Lenovo, 苹果/Apple, 华为/Huawei, 华硕/ASUS, 宏碁/Acer, 微软/Microsoft, 其他/Other）"},
          {"name": "status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["online", "offline", "maintenance", "retired"]}, "description": "状态过滤"},
          {"name": "os", "in": "query", "required": false, "schema": {"type": "string"}, "description": "操作系统过滤"},
          {"name": "department", "in": "query", "required": false, "schema": {"type": "string"}, "description": "部门过滤"},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 20, "minimum": 1, "maximum": 100}, "description": "返回条数上限"}
        ],
        "responses": {
          "200": {
            "description": "匹配的终端PC列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {"type": "integer"},
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "hostname": {"type": "string"},
                          "sn": {"type": "string"},
                          "assetTag": {"type": "string"},
                          "manufacturer": {"type": "string"},
                          "model": {"type": "string"},
                          "os": {"type": "string"},
                          "bizIp": {"type": "string"},
                          "userName": {"type": "string"},
                          "department": {"type": "string"},
                          "status": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/get-workstation-detail": {
      "get": {
        "operationId": "get_workstation_detail",
        "summary": "获取终端PC完整详情",
        "description": "根据计算机名、SN序列号、资产编号或IP地址获取单台终端PC的完整配置信息，包括CPU、内存、硬盘、MAC地址、操作系统版本、使用人、部门、显示器等。适用场景：用户问「BJ-FIN-001 的内存多大」「SN:WKS001 的硬盘是什么」「192.168.1.100 是谁的电脑」等。",
        "parameters": [
          {"name": "identifier", "in": "query", "required": true, "schema": {"type": "string"}, "description": "计算机名、SN序列号、资产编号或IP地址"}
        ],
        "responses": {
          "200": {
            "description": "终端PC详情",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "found": {"type": "boolean"},
                    "message": {"type": "string"},
                    "hostname": {"type": "string"},
                    "sn": {"type": "string"},
                    "assetTag": {"type": "string"},
                    "manufacturer": {"type": "string"},
                    "model": {"type": "string"},
                    "cpuModel": {"type": "string"},
                    "cpuCount": {"type": "integer"},
                    "memoryGB": {"type": "integer"},
                    "diskType": {"type": "string"},
                    "diskCapacityGB": {"type": "integer"},
                    "macAddress": {"type": "string"},
                    "os": {"type": "string"},
                    "osVersion": {"type": "string"},
                    "bizIp": {"type": "string"},
                    "userName": {"type": "string"},
                    "department": {"type": "string"},
                    "officeBuilding": {"type": "string"},
                    "floor": {"type": "string"},
                    "seat": {"type": "string"},
                    "status": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/get-server-bmc-status": {
      "get": {
        "operationId": "get_server_bmc_status",
        "summary": "获取主机 BMC 实时硬件状态",
        "description": "获取某台主机的 BMC 实时硬件状态信息，包括电源状态、整机健康、CPU温度、进风口温度、风扇列表（名称/转速/状态/数量）、内存详情（总量 + 每根 DIMM 的槽位/型号/序列号/容量/类型/状态）、磁盘列表（名称/型号/序列号/容量/介质类型/状态/数量）、电源模块列表（名称/当前功率/额定功率/状态/数量）、启动进度、告警列表等。数据来源于 BMC Redfish/IPMI 实时采集，非在线主机回退为模拟数据。适用场景：用户问「DB-SH-01 的 CPU 温度是多少」「这台机器有几根内存」「查一下 10.0.1.5 的内存配置」「硬盘和内存的详细信息」「电源功率使用情况」等。",
        "parameters": [
          {
            "name": "identifier",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "主机名、SN序列号、资产编号或IP地址"
          }
        ],
        "responses": {
          "200": {
            "description": "BMC 硬件状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "found": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "hostname": {
                      "type": "string"
                    },
                    "sn": {
                      "type": "string"
                    },
                    "assetTag": {
                      "type": "string"
                    },
                    "manufacturer": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "mgmtIp": {
                      "type": "string"
                    },
                    "bizIp": {
                      "type": "string"
                    },
                    "bmcProtocol": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string",
                      "description": "数据来源: live 或 simulated"
                    },
                    "collectedAt": {
                      "type": "string",
                      "description": "最近一次实时采集时间 ISO8601"
                    },
                    "power": {
                      "type": "string",
                      "enum": [
                        "On",
                        "Off"
                      ]
                    },
                    "health": {
                      "type": "string",
                      "enum": [
                        "OK",
                        "Warning",
                        "Critical"
                      ]
                    },
                    "bootProgress": {
                      "type": "string"
                    },
                    "cpuTempC": {
                      "type": "number",
                      "description": "CPU 温度（摄氏度）"
                    },
                    "inletTempC": {
                      "type": "number",
                      "description": "进风口温度（摄氏度）"
                    },
                    "fanCount": {
                      "type": "integer"
                    },
                    "fans": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "rpm": {
                            "type": "integer"
                          },
                          "status": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "memoryTotalGiB": {
                      "type": "number",
                      "description": "内存总量（GiB），来自 BMC MemorySummary"
                    },
                    "memoryModuleCount": {
                      "type": "integer",
                      "description": "DIMM 内存条数量"
                    },
                    "memoryModules": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "slot": {
                            "type": "string",
