# ================================================================
# HTTPS 配置模板（生产环境推荐）
# ================================================================
# 使用方法：
#   1. 将证书文件放到 reference-backend/nginx/certs/ 目录
#   2. 修改下方 ssl_certificate / ssl_certificate_key 路径
#   3. 替换 docker-compose.yml 中 web 的 nginx 挂载：
#      - ./reference-backend/nginx/default-https.conf:/etc/nginx/conf.d/default.conf:ro
#      - ./reference-backend/nginx/certs:/etc/nginx/certs:ro
#   4. 如需自动跳转 HTTP→HTTPS，取消注释最下方 80→443 重定向块
# ================================================================

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name your-domain.com;

    # ---- 证书路径（按实际情况修改） ----
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # ---- 现代安全配置 ----
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS（确认 HTTPS 稳定后再取消注释）
    # add_header Strict-Transport-Security "max-age=63072000" always;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 32m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml application/wasm font/ttf font/otf image/svg+xml;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        try_files $uri =404;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        proxy_pass http://api:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location = /healthz {
        proxy_pass http://api:8000/healthz;
        access_log off;
    }
}

# ---- HTTP → HTTPS 自动跳转（可选） ----
# 启用时需额外暴露 80 端口并在 docker-compose.yml 中取消注释 ports 的 80 映射
# server {
#     listen 80;
#     listen [::]:80;
#     server_name your-domain.com;
#     return 301 https://$host$request_uri;
# }
